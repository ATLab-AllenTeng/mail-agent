# macOS Mail Agent 設定：複製為 .env 後填入實際值
#   cp .env.example .env && chmod 600 .env
# 所有變數都用 MAIL_AGENT_ 前綴，不會和 ~/.zshrc 裡給其他應用用的 OPENAI_* 互相干擾。
# 已存在的環境變數優先於 .env，臨時覆蓋可用：MAIL_AGENT_MODEL=xxx python3 run_agent.py

# ── 郵件 ─────────────────────────────────────────────────────────────
# 郵件 App 側邊欄顯示的帳號名稱，多個以逗號分隔；用 --list-accounts 查看
MAIL_AGENT_ACCOUNT=Celxpert,Keelgoal
# 收件夾名稱，程式會自動嘗試 INBOX / Inbox / 收件匣；找不到時用 --list-mailboxes 查看後指定
# MAIL_AGENT_MAILBOX=INBOX

# ── LLM 端點 ─────────────────────────────────────────────────────────
# 接自架 llm-router (預設做法)：
MAIL_AGENT_BASE_URL=http://127.0.0.1:9001/v1
MAIL_AGENT_API_KEY=<llm-router 的 LLM_ROUTER_API_KEY>
MAIL_AGENT_MODEL=Mail-Briefing
#
# 直接接 OpenAI 官方：把 MAIL_AGENT_BASE_URL 整行刪掉或留空，API key 填 OpenAI 的
# MAIL_AGENT_BASE_URL=
# MAIL_AGENT_API_KEY=sk-...
# MAIL_AGENT_MODEL=gpt-4o

# 結構化輸出方式：auto (有 BASE_URL 用 prompt，否則 schema) / schema / prompt
# MAIL_AGENT_JSON_MODE=auto

# ── 其他 ─────────────────────────────────────────────────────────────
# 每封信送出的內文字元上限、每次 LLM 呼叫最多幾封信
# MAIL_AGENT_MAX_BODY_CHARS=4000
# MAIL_AGENT_BATCH_SIZE=10
